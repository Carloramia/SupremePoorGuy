      "isDeleted": false,
      "boundElements": null,
      "updated": 1791863574018,
      "created": 1791862411318,
      "link": null,
      "locked": false,
      "text": "D1区存在怪物信息需要\n包括部分词条，数值。\n但这部分等后续系统回\n收再说。",
      "fontSize": 20,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ddEyifFQLoJr_cV5u0n2G",
      "originalText": "D1区存在怪物信息需要包括部分词条，数值。但这部分等后续系统回收再说。",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "q4gAw0xDHTPowboojDDkq",
      "type": "stickynote",
      "x": 1358.4426012863698,
      "y": 2474.160256371775,
      "width": 250,
      "height": 374.5449921400595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffdf6b",
      "fillStyle": "solid",
