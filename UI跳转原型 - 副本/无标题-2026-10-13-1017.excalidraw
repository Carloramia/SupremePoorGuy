    {
      "id": "qmKHyAiWK_df7VDK4gbLd",
      "type": "text",
      "x": 1374.4426012863698,
      "y": 2573.932752441805,
      "width": 214.13999938964844,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8Cc",
