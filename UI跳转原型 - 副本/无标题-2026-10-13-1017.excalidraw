      "isDeleted": false,
      "boundElements": null,
      "updated": 1791864313669,
      "created": 1791864299618,
      "link": null,
      "locked": false,
      "text": "鼠标移动到怪物上能快\n速查看",
      "fontSize": 20,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "qSrf-0RCF_nFqitntjVp4",
      "originalText": "鼠标移动到怪物上能快速查看",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xFh1PlRCodQFRdMIRhJ-Z",
      "type": "stickynote",
      "x": 2580.050836391369,
      "y": 1951.1304134918137,
      "width": 250,
      "height": 374.5449921400595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffdf6b",
      "fillStyle": "solid",
