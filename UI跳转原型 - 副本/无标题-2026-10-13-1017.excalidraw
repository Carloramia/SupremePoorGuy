    },
    {
      "id": "oU6z3g_FJM9XEfHTDY813",
      "type": "text",
      "x": 3244.128959028493,
      "y": 1534.2027580893557,
      "width": 201.11997985839844,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8F",
