      "isDeleted": false,
      "boundElements": null,
      "updated": 1791861639941,
      "created": 1791861483266,
      "link": null,
      "locked": false,
      "text": "C2区主要是放置召唤\n阵，以及召唤按钮。召\n唤时候唤起E区",
      "fontSize": 20,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "jIHK-5eJAHL7_RdoUeliK",
      "originalText": "C2区主要是放置召唤阵，以及召唤按钮。召唤时候唤起E区",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wEZPcwUhQcEyGUVT0qais",
      "type": "stickynote",
      "x": 3228.128959028493,
      "y": 1434.430262019326,
      "width": 250,
      "height": 374.5449921400595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffdf6b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
