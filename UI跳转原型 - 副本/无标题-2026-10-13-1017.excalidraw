    {
      "id": "385yC7Jfk4njybsWDZ5hi",
      "type": "text",
      "x": 1358.488372050505,
      "y": 1482.5158172048252,
      "width": 201.11997985839844,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a88",
      "roundness": null,
      "seed": 537481381,
      "version": 338,
      "versionNonce": 1323096555,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791862768268,
      "created": 1791860766815,
      "link": null,
      "locked": false,
      "text": "C1C2C3的材质都是纸\n\nC1区负责表现当前的影\n响因素，包括所处地\n区，天气。召唤阵的消\n耗与附加，擦除召唤阵\n线条。\n\n\n\n",
      "fontSize": 20,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "2FlY_iFl11z-ITG_gF9qk",
      "originalText": "C1C2C3的材质都是纸\n\nC1区负责表现当前的影响因素，包括所处地区，天气。召唤阵的消耗与附加，擦除召唤阵线条。\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
