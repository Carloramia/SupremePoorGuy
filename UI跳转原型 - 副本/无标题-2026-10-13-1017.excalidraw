      "text": "D1、D2两个区域的材质\n都是木板。\n\n\n\n",
      "fontSize": 20,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "M2ztkae3wVBhuDO7A1txk",
      "originalText": "D1、D2两个区域的材质都是木板。\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "7negabmb8bxr0yITJKEIc",
      "type": "stickynote",
      "x": 1898.3018717241494,
      "y": 1432.7433211347955,
      "width": 250,
      "height": 374.5449921400595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffdf6b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
