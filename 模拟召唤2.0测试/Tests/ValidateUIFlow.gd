extends SceneTree
const ROUTER = preload("res://Scripts/UI/Navigation/UIFlowRouter.gd")
const SHELL = preload("res://Scenes/UI/Navigation/UIFlowDemo.tscn")
var requests: Array[Dictionary] = []

func _initialize() -> void:
	call_deferred("_validate")

func _validate() -> void:
	var router = ROUTER.new()
	root.add_child(router)
	router.action_requested.connect(func(action, context): requests.append({"action": action, "context": context}))
	var source := {"location_id": "grassland", "position": {"x": 10}}
	router.start(source)
	source.position.x = 99
	assert(router.current_context().position.x == 10)
	assert(not router.go_back())
	assert(not router.navigate(&"invalid"))
	assert(not router.navigate(&"battle"))
	assert(router.navigate(&"world"))
	assert(router.navigate(&"local", {"local_position": [2, 3]}))
	assert(router.open_overlay(&"warehouse"))
	assert(not router.open_overlay(&"warehouse"))
	assert(not router.navigate(&"summon"))
	assert(router.open_overlay(&"monster", {"monster_id": "sample"}))
	router.request_action(&"monster_rename")
	assert(requests.size() == 1)
	assert(requests[0].context.monster_id == "sample")
	assert(requests[0].context.ui_overlay == &"monster")
	assert(router.go_back())
	assert(router.overlays.back().route == &"warehouse")
	assert(router.go_back())
	assert(router.current_route() == &"local")
	assert(router.navigate(&"summon"))
	router.request_action(&"summon_confirm")
	assert(router.current_route() == &"summon")
	assert(router.navigate(&"summon_result"))
	assert(router.finish_summon_preview())
	assert(router.current_route() == &"summon")
	assert(router.go_back())
	assert(router.navigate(&"deployment"))
	assert(router.navigate(&"battle"))
	assert(not router.go_back())
	assert(router.navigate(&"settlement"))
	router.request_action(&"settlement_confirm")
	assert(router.current_route() == &"settlement")
	assert(router.return_to_exploration())
	assert(not router.return_to_exploration())
	assert(router.current_route() == &"local")
	assert(router.current_context().local_position == [2, 3])
	assert(router.go_back())
	assert(router.current_route() == &"world")
	router.queue_free()
	var shell = SHELL.instantiate()
	root.add_child(shell)
	await process_frame
	var ui_router = shell.get_node("Router")
	assert(shell.page.get_child_count() >= 3)
	assert(shell.back_button.disabled)
	for route in [&"world", &"local", &"summon", &"summon_result"]:
		assert(ui_router.navigate(route))
		assert(shell.route_label.text.contains(String(route)))
	for overlay in ui_router.OVERLAYS:
		assert(ui_router.open_overlay(overlay))
		assert(shell.blocker.visible)
		assert(shell.back_button.disabled)
		assert(ui_router.go_back())
		assert(not shell.blocker.visible)
	assert(ui_router.finish_summon_preview())
	assert(ui_router.go_back())
	for route in [&"deployment", &"battle", &"settlement"]:
		assert(ui_router.navigate(route))
		assert(shell.route_label.text.contains(String(route)))
	assert(ui_router.return_to_exploration())
	assert(not paused)
	shell.queue_free()
	await process_frame
	print("UI_FLOW_VALIDATION_PASSED")
	quit(0)
