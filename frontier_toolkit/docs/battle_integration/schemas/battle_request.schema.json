{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed BattleRequest v1 (not implemented at runtime)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "battle_id", "map_id", "location_id", "encounter_id", "scene_id", "seed", "party_revision", "ruleset_id", "balance_version", "party_slots_limit", "health_policy", "party", "waves", "return_context"],
  "properties": {
    "schema_version": {"const": 1},
    "battle_id": {"$ref": "#/$defs/id"},
    "map_id": {"$ref": "#/$defs/id"},
    "location_id": {"$ref": "#/$defs/id"},
    "encounter_id": {"$ref": "#/$defs/id"},
    "scene_id": {"$ref": "#/$defs/id"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "party_revision": {"type": "integer", "minimum": 0},
    "ruleset_id": {"$ref": "#/$defs/id"},
    "balance_version": {"$ref": "#/$defs/id"},
    "party_slots_limit": {"const": 6},
    "health_policy": {"enum": ["session_only", "persist_parts"]},
    "party": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}},
    "waves": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/wave"}},
    "return_context": {
      "type": "object", "additionalProperties": false,
      "required": ["route", "location_id"],
      "properties": {"route": {"const": "world"}, "location_id": {"$ref": "#/$defs/id"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "nonnegative": {"type": "number", "minimum": 0},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["hp", "attack", "armor", "speed", "interval", "visual_scale", "part_hp"],
      "properties": {
        "hp": {"$ref": "#/$defs/positive"}, "attack": {"$ref": "#/$defs/nonnegative"},
        "armor": {"$ref": "#/$defs/nonnegative"}, "speed": {"$ref": "#/$defs/nonnegative"},
        "interval": {"$ref": "#/$defs/positive"}, "visual_scale": {"$ref": "#/$defs/positive"},
        "part_hp": {
          "type": "object", "additionalProperties": false, "required": ["head", "core", "limb"],
          "properties": {"head": {"$ref": "#/$defs/positive"}, "core": {"$ref": "#/$defs/positive"}, "limb": {"$ref": "#/$defs/positive"}}
        }
      }
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["monster_id", "actor_id", "archetype_id", "blueprint_id", "blueprint_revision", "faction_id", "spawn_id", "mode", "slot_group", "slot_cost", "batch_id", "recoverable", "stat_profile"],
      "properties": {
        "monster_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"},
        "archetype_id": {"$ref": "#/$defs/id"}, "blueprint_id": {"$ref": "#/$defs/id"},
        "blueprint_revision": {"type": "integer", "minimum": 1},
        "faction_id": {"type": "integer", "minimum": 0}, "spawn_id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["normal", "giant", "ultra", "tiny", "multiply", "special"]},
        "slot_group": {"$ref": "#/$defs/id"}, "slot_cost": {"type": "integer", "minimum": 1, "maximum": 5},
        "batch_id": {"$ref": "#/$defs/id"}, "recoverable": {"type": "boolean"},
        "stat_profile": {"$ref": "#/$defs/profile"}
      }
    },
    "enemy": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "archetype_id", "faction_id", "spawn_id"],
      "properties": {"actor_id": {"$ref": "#/$defs/id"}, "archetype_id": {"$ref": "#/$defs/id"}, "faction_id": {"type": "integer", "minimum": 0}, "spawn_id": {"$ref": "#/$defs/id"}}
    },
    "wave": {
      "type": "object", "additionalProperties": false, "required": ["wave_id", "trigger", "enemies"],
      "properties": {"wave_id": {"$ref": "#/$defs/id"}, "trigger": {"enum": ["on_start", "after_previous"]}, "enemies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enemy"}}}
    }
  }
}
