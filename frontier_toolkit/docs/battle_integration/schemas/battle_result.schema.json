{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed BattleResult v1 (not implemented at runtime)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "battle_id", "map_id", "location_id", "party_revision", "outcome", "reason_code", "health_policy", "duration_seconds", "unit_results", "rewards", "metrics"],
  "properties": {
    "schema_version": {"const": 1}, "result_id": {"$ref": "#/$defs/id"},
    "battle_id": {"$ref": "#/$defs/id"}, "map_id": {"$ref": "#/$defs/id"}, "location_id": {"$ref": "#/$defs/id"},
    "party_revision": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["victory", "defeat", "retreat", "canceled", "error"]},
    "reason_code": {"$ref": "#/$defs/id"}, "health_policy": {"enum": ["session_only", "persist_parts"]},
    "duration_seconds": {"type": "number", "minimum": 0},
    "unit_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "rewards": {
      "type": "object", "additionalProperties": false, "required": ["magic", "items"],
      "properties": {
        "magic": {"type": "integer", "minimum": 0},
        "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "quantity"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "quantity": {"type": "integer", "minimum": 1}}}}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false, "required": ["enemy_defeated", "ally_disabled"],
      "properties": {"enemy_defeated": {"type": "integer", "minimum": 0}, "ally_disabled": {"type": "integer", "minimum": 0}}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "part": {
      "type": "object", "additionalProperties": false, "required": ["part_key", "max_hp", "current_hp", "broken"],
      "properties": {"part_key": {"type": "string", "minLength": 1, "maxLength": 256}, "max_hp": {"type": "number", "exclusiveMinimum": 0}, "current_hp": {"type": "number", "minimum": 0}, "broken": {"type": "boolean"}}
    },
    "unit": {
      "type": "object", "additionalProperties": false, "required": ["monster_id", "actor_id", "status", "parts"],
      "properties": {"monster_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["alive", "dead", "unspawned"]}, "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}}}
    }
  }
}
